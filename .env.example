# Copy to a private environment configuration; never commit real secrets.
# For an HTTPS deployment, supply these values via the host/service manager.
UNIRESERVE_MODE=production
UNIRESERVE_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
UNIRESERVE_TRUSTED_HOSTS=reservations.example.edu
UNIRESERVE_DB_PATH=instance/unireserve.sqlite3
UNIRESERVE_TIMEZONE=Asia/Baku
UNIRESERVE_AUTO_SAMPLE_CATALOG=0
UNIRESERVE_PORT=8080
