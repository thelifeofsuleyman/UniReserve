@startuml
title UniReserve - Use Case Model
left to right direction
skinparam shadowing false
actor "Student" as Student
actor "Staff" as Staff
actor "Resource Administrator" as Admin
rectangle "UniReserve" {
  usecase "UC-01\nAuthenticate" as UC01
  usecase "UC-02\nBrowse resources\nand availability" as UC02
  usecase "UC-03\nRequest reservation" as UC03
  usecase "UC-04\nView/cancel own\nreservation" as UC04
  usecase "UC-05\nApprove/reject\npending request" as UC05
  usecase "UC-06\nManage resource\ncatalogue" as UC06
}
Student --> UC01
Student --> UC02
Student --> UC03
Student --> UC04
Staff --> UC01
Staff --> UC02
Staff --> UC03
Staff --> UC04
Admin --> UC01
Admin --> UC02
Admin --> UC05
Admin --> UC06
note bottom of UC03
  Restricted resources create PENDING_APPROVAL.
  Only CONFIRMED reservations block capacity.
end note
@enduml